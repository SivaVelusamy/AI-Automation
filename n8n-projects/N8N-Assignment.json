          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        112,
        -160
      ],
      "id": "86ca9980-fe4d-4ee1-a245-d874c5e44c7d",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "EpHpJtatxQpg05xJ",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfunction parseStudent(value) {\n  if (value === undefined || value === null) {\n    throw new Error(\"AI response is empty or field was not found\");\n  }\n\n  // Already an object\n  if (typeof value === 'object') {\n    return value;\n  }\n\n  let text = String(value).trim();\n\n  // Remove markdown code fences\n  text = text\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```\\s*/i, '')\n    .replace(/\\s*```$/i, '')\n    .trim();\n\n  // First JSON.parse\n  let parsed = JSON.parse(text);\n\n  // If AI returned JSON encoded as a string, parse again\n  if (typeof parsed === 'string') {\n    parsed = JSON.parse(parsed);\n  }\n\n  return parsed;\n}\n\nfunction cleanStudent(student) {\n\n  if (!student || typeof student !== 'object') {\n    throw new Error(\"Parsed AI response is not a student object\");\n  }\n\n  const email = String(student.Email ?? '')\n    .trim()\n    .toLowerCase();\n\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n  return {\n    Student_ID: String(student.Student_ID ?? '').trim(),\n\n    Name: String(student.Name ?? '')\n      .replace(/\\s+/g, ' ')\n      .trim(),\n\n    Email: email,\n\n    Email_Valid: emailRegex.test(email),\n\n    Phone: String(student.Phone ?? '')\n      .replace(/\\D/g, ''),\n\n    Course: String(student.Course ?? '')\n      .replace(/\\s+/g, ' ')\n      .trim(),\n\n    Fee_Paid:\n      student.Fee_Paid === true ||\n      String(student.Fee_Paid).toLowerCase() === 'true',\n\n    City: String(student.City ?? '')\n      .replace(/\\s+/g, ' ')\n      .trim(),\n\n    Enrolled_Date: String(student.Enrolled_Date ?? '').trim()\n  };\n}\n\nconst results = [];\n\nfor (const item of items) {\n\n  try {\n\n    // Look for the AI response automatically\n    const possibleFields = [\n      'output',\n      'text',\n      'response',\n      'content',\n      'message',\n      'result'\n    ];\n\n    let aiResponse = null;\n\n    for (const field of possibleFields) {\n      if (item.json[field] !== undefined) {\n        aiResponse = item.json[field];\n        break;\n      }\n    }\n\n    // If no known field exists, try the entire JSON object\n    if (aiResponse === null) {\n      aiResponse = item.json;\n    }\n\n    const parsed = parseStudent(aiResponse);\n\n    // Support both a single student and an array\n    const students = Array.isArray(parsed)\n      ? parsed\n      : [parsed];\n\n    for (const student of students) {\n\n      const cleaned = cleanStudent(student);\n\n      results.push({\n        json: cleaned\n      });\n\n    }\n\n  } catch (error) {\n\n    results.push({\n      json: {\n        error: true,\n        message: error.message,\n        original_data: item.json\n      }\n    });\n\n  }\n}\n\nreturn results;"
      },
